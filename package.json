{
	"name": "uk-finance-api",
	"description": "A UK-based backend API for household finances, tax, National Insurance, benefits, budgeting, debt assessment, affordability, and repayment calculations.",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"start": "node dist/server.js",
		"typecheck": "tsc",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run src",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:coverage": "vitest run --coverage",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:baseline": "tsx scripts/adopt-baseline.ts",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:export": "drizzle-kit export",
		"db:check": "drizzle-kit check",
		"db:up": "drizzle-kit up",
		"db:studio": "drizzle-kit studio",
		"db:test": "tsx src/db/check-connection.ts",
		"auth:generate": "corepack pnpm dlx @better-auth/cli@latest generate --config src/lib/auth.ts --output ./src/db/schema/auth.schema.ts -y",
		"verify": "biome check . && tsc && vitest run && corepack pnpm openapi:lint && corepack pnpm sdk:check && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"openapi:export": "tsx scripts/export-openapi.ts && biome format --write openapi/openapi.json openapi/money.openapi.json",
		"openapi:lint": "corepack pnpm openapi:export && redocly lint openapi/openapi.json openapi/money.openapi.json --config redocly.yaml && tsx scripts/check-openapi.ts openapi/openapi.json && tsx scripts/check-openapi.ts openapi/money.openapi.json",
		"openapi:check": "corepack pnpm openapi:lint && git diff --exit-code -- openapi/openapi.json openapi/money.openapi.json",
		"sdk:generate": "openapi-ts",
		"sdk:check": "openapi-ts && tsx scripts/check-sdk-determinism.ts && tsc -p tsconfig.sdk.json",
		"sdk:build": "openapi-ts && tsc -p tsconfig.sdk.build.json && tsc-alias -p tsconfig.sdk.build.json --resolve-full-paths --resolve-full-extension .js",
		"sdk:pack": "corepack pnpm sdk:build && tsx scripts/prepare-sdk-package.ts && npm pack --dry-run ./.tmp/npm-package"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.25",
		"@better-auth/expo": "1.6.25",
		"@hono/node-server": "^2.0.12",
		"@hono/zod-openapi": "^1.5.1",
		"@scalar/hono-api-reference": "^0.11.11",
		"@t3-oss/env-core": "^0.13.11",
		"better-auth": "^1.6.25",
		"decimal.js": "^10.6.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.12.32",
		"ioredis": "^5.11.1",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"rate-limiter-flexible": "^11.2.0",
		"stoker": "^2.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@hey-api/openapi-ts": "^0.99.0",
		"@redocly/cli": "^2.43.3",
		"@testcontainers/postgresql": "^12.0.4",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "1.0.0-rc.4",
		"pino-pretty": "^13.1.3",
		"testcontainers": "^12.0.4",
		"tsc-alias": "^1.9.1",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@10.33.4"
}
