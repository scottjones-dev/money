{
	"name": "uk-finance-api",
	"description": "A UK-based backend API for household finances, tax, National Insurance, benefits, budgeting, debt assessment, affordability, and repayment calculations.",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run src",
		"test:integration": "vitest run tests/integration",
		"test:coverage": "vitest run --coverage",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:export": "drizzle-kit export",
		"db:check": "drizzle-kit check",
		"db:up": "drizzle-kit up",
		"db:studio": "drizzle-kit studio",
		"db:test": "tsx src/db/check-connection.ts",
		"auth:generate": "pnpm dlx @better-auth/cli@latest generate --config src/lib/auth.ts --output ./src/db/schema/auth.schema.ts -y",
		"verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
		"openapi:export": "tsx scripts/export-openapi.ts",
		"openapi:check": "pnpm openapi:export && git diff --exit-code -- openapi/openapi.json"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.25",
		"@hono/node-server": "^2.0.12",
		"@hono/zod-openapi": "^1.5.1",
		"@scalar/hono-api-reference": "^0.11.11",
		"@t3-oss/env-core": "^0.13.11",
		"better-auth": "^1.6.25",
		"date-fns": "^4.4.0",
		"decimal.js": "^10.6.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.12.32",
		"hono-pino": "^0.10.3",
		"ioredis": "^5.11.1",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"rate-limiter-flexible": "^11.2.0",
		"stoker": "^2.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@testcontainers/postgresql": "^12.0.4",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "1.0.0-rc.4",
		"pino-pretty": "^13.1.3",
		"testcontainers": "^12.0.4",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.4"
}
