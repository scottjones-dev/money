NODE_ENV=development
PORT=9000
PUBLIC_BASE_URL=http://localhost:9000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379

DATABASE_URL=
DATABASE_SSL=false

BETTER_AUTH_URL=http://localhost:9000
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_CURRENT_KEY_ID=v1
# Comma-separated keyId:base64-encoded-32-byte-key entries. Keep old keys during rotation.
DATA_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY

LOG_LEVEL=debug
